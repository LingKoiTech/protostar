{
  "name": "@protostar/components",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "description": "Reusable reference-led Neomorphism components built with Base UI and Lucide React.",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./theme-tokens.css": "./src/styles/themes.css",
    "./material-tokens.css": "./src/styles/materials.css"
  },
  "sideEffects": ["./src/styles.css", "./src/styles/*.css"],
  "scripts": {
    "dev:components-gallery": "pnpm --filter @protostar/components-gallery dev",
    "build:components-gallery": "pnpm --filter @protostar/components-gallery build",
    "test:components": "vitest run",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
